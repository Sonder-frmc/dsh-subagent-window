{
  "name": "@local/subagent-window",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Floats a DSH subagent's conversation in a draggable in-app window, so you can keep the main conversation visible while reading, messaging, confirming permissions or stopping that subagent.",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "subagent",
    "floating-window"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Sonder-frmc/dsh-subagent-window#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sonder-frmc/dsh-subagent-window.git"
  }
}
